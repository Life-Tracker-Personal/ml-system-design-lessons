# Provider: openrouter (default), openai, anthropic, google, local
# Any unlisted name is treated as openai-compatible (set BRIDGE_BASE_URL).
BRIDGE_PROVIDER=openrouter

# API key for the selected provider (not needed for "local").
BRIDGE_API_KEY=sk-or-v1-...

# Model identifier — provider-specific. Defaults per provider:
#   openrouter  → anthropic/claude-sonnet-4-20250514
#   openai      → gpt-4o
#   anthropic   → claude-sonnet-4-20250514
#   google      → gemini-2.5-flash
#   local       → sonnet
# BRIDGE_MODEL=

# Override the base URL (only needed for custom endpoints).
# BRIDGE_BASE_URL=

# Shared secret for Authorization: Bearer <token> (optional but recommended).
# BRIDGE_TOKEN=

# Max response tokens (default 4096, ignored by local provider).
# BRIDGE_MAX_TOKENS=4096

# Request timeout in seconds.
# BRIDGE_TIMEOUT_S=120

# Max characters accepted in a query.
# BRIDGE_MAX_QUERY_CHARS=8000

# CORS origins (comma-separated).
# BRIDGE_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# System prompt override.
# BRIDGE_SYSTEM_PROMPT=

# Local provider only: path to the claude binary.
# CLAUDE_BIN=
