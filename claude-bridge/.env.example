# Model alias ('sonnet' / 'opus' / 'haiku') or a full model id.
BRIDGE_MODEL=sonnet

# Shared secret (optional but recommended).
# BRIDGE_TOKEN=

# Path to the claude binary (auto-detected if on PATH).
# CLAUDE_BIN=

# BRIDGE_HOST=127.0.0.1
# BRIDGE_PORT=8787
# BRIDGE_TIMEOUT_S=120
# BRIDGE_MAX_QUERY_CHARS=8000
# BRIDGE_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
